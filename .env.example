# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Node/Express server port (defaults to 3000)
PORT="3000"

# SMTP Email Configuration for Contact Form Enquiries (optional; enquiries also persist to server storage)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="hello@funmedia.com.np"
SMTP_PASS=""
CONTACT_RECIPIENT_EMAIL="hello@funmedia.com.np"
